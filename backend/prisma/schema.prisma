generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrgType {
  ngo
  govt
  hospital
  shelter
  foodbank
}

enum OrgLegalStructure {
  ngo_trust
  section8
  society
  govt_body
  social_enterprise
  other
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum OrgRole {
  admin
  staff
}

enum OrgInviteStatus {
  pending
  accepted
  revoked
}

enum OrgTaskStatus {
  assigned
  in_progress
  completed
}

enum OrgTaskPriority {
  low
  medium
  high
  urgent
}

enum ServiceDeliveryMode {
  at_centre
  doorstep
  online
  mobile_camp
}

enum UserType {
  citizen
  org_staff
  platform_admin
}

enum Severity {
  low
  medium
  high
  critical
}

enum ReportStatus {
  new
  processing
  resolved
  closed
}

enum ReferralStatus {
  pending
  contacted
  in_progress
  fulfilled
  declined
}

enum FollowUpMethod {
  call
  sms
}

enum OutcomeType {
  resolved
  partial
  unresolved
}

enum DisasterType {
  flood
  earthquake
  fire
  other
}

enum RuleType {
  income_below
  age_above
  location_radius_km
  document_required
}

model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  email     String   @unique
  password  String
  userType  UserType @default(citizen)
  createdAt DateTime @default(now())

  profile          Profile?
  orgMembers       OrgMember[]
  reports          Report[]
  verifiedOrgs     Organization[]          @relation("VerifiedBy")
  statusChanges    ReferralStatusHistory[]
  assignedOrgTasks OrgTask[]               @relation("AssignedOrgTasks")
  createdOrgTasks  OrgTask[]               @relation("CreatedOrgTasks")

  @@map("users")
}

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique
  fullName          String?
  preferredLanguage String   @default("hi")
  address           String?
  lat               Float?
  lng               Float?
  isComplete        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model Organization {
  id                 String             @id @default(uuid())
  name               String
  type               OrgType
  legalStructure     OrgLegalStructure
  verificationStatus VerificationStatus @default(pending)

  registrationNumber String
  yearEstablished    Int
  website            String?
  description        String?

  contactName  String
  designation  String
  email        String
  contactPhone String?

  address  String?
  city     String
  district String
  state    String
  pincode  String
  lat      Float?
  lng      Float?

  serviceAreas       String?
  beneficiariesCount Int?
  focusAreas         String[]

  registrationCertUrl String?
  panDocUrl           String?
  addressProofUrl     String?
  authLetterUrl       String?
  logoUrl             String?

  verifiedBy     String?
  verifiedByUser User?    @relation("VerifiedBy", fields: [verifiedBy], references: [id])
  createdAt      DateTime @default(now())

  members     OrgMember[]
  services    Service[]
  invitations OrgInvitation[]
  tasks       OrgTask[]

  @@map("organizations")
}

model OrgTask {
  id                 String          @id @default(uuid())
  orgId              String
  assignedToId       String
  createdById        String
  title              String
  description        String
  complaintReference String?
  area               String
  address            String
  city               String?
  district           String?
  state              String?
  pincode            String?
  lat                Float?
  lng                Float?
  priority           OrgTaskPriority @default(medium)
  status             OrgTaskStatus   @default(assigned)
  beforeImageUrl     String?
  afterImageUrl      String?
  completionNote     String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignedTo   User         @relation("AssignedOrgTasks", fields: [assignedToId], references: [id])
  createdBy    User         @relation("CreatedOrgTasks", fields: [createdById], references: [id])

  @@index([orgId, status])
  @@index([assignedToId, status])
  @@map("org_tasks")
}

model OrgMember {
  id     String  @id @default(uuid())
  orgId  String
  userId String
  role   OrgRole

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@unique([userId])
  @@map("org_members")
}

model OrgInvitation {
  id         String          @id @default(uuid())
  orgId      String
  email      String
  role       OrgRole         @default(staff)
  token      String          @unique
  status     OrgInviteStatus @default(pending)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime        @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, email])
  @@map("org_invitations")
}

model ProblemCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  services      Service[]
  detectedNeeds DetectedNeed[]

  @@map("problem_categories")
}

model Service {
  id                String              @id @default(uuid())
  orgId             String
  categoryId        Int
  name              String
  description       String?
  capacity          Int?
  capacityUnit      String?
  deliveryMode      ServiceDeliveryMode @default(at_centre)
  availability      String?
  serviceArea       String?
  contactPhone      String?
  eligibility       String?
  requiredDocuments String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization     Organization      @relation(fields: [orgId], references: [id])
  category         ProblemCategory   @relation(fields: [categoryId], references: [id])
  eligibilityRules EligibilityRule[]
  referrals        Referral[]

  @@index([orgId, isActive])
  @@index([categoryId, isActive])
  @@map("services")
}

model EligibilityRule {
  id        String   @id @default(uuid())
  serviceId String
  ruleType  RuleType
  ruleValue String

  service Service @relation(fields: [serviceId], references: [id])

  @@map("eligibility_rules")
}

model DisasterEvent {
  id           String       @id @default(uuid())
  name         String
  type         DisasterType
  affectedArea String?
  startDate    DateTime
  active       Boolean      @default(true)

  reports Report[]

  @@map("disaster_events")
}

model Report {
  id              String       @id @default(uuid())
  userId          String?
  rawText         String
  lat             Float?
  lng             Float?
  severity        Severity     @default(medium)
  status          ReportStatus @default(new)
  disasterEventId String?
  createdAt       DateTime     @default(now())

  user          User?          @relation(fields: [userId], references: [id])
  disasterEvent DisasterEvent? @relation(fields: [disasterEventId], references: [id])
  detectedNeeds DetectedNeed[]

  @@map("reports")
}

model DetectedNeed {
  id              String  @id @default(uuid())
  reportId        String
  categoryId      Int
  confidenceScore Float?
  description     String?

  report    Report          @relation(fields: [reportId], references: [id])
  category  ProblemCategory @relation(fields: [categoryId], references: [id])
  referrals Referral[]

  @@map("detected_needs")
}

model Referral {
  id        String         @id @default(uuid())
  needId    String
  serviceId String
  status    ReferralStatus @default(pending)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  need          DetectedNeed            @relation(fields: [needId], references: [id])
  service       Service                 @relation(fields: [serviceId], references: [id])
  statusHistory ReferralStatusHistory[]
  followUps     FollowUp[]
  outcome       Outcome?

  @@map("referrals")
}

model ReferralStatusHistory {
  id         String         @id @default(uuid())
  referralId String
  status     ReferralStatus
  note       String?
  changedBy  String?
  changedAt  DateTime       @default(now())

  referral      Referral @relation(fields: [referralId], references: [id])
  changedByUser User?    @relation(fields: [changedBy], references: [id])

  @@map("referral_status_history")
}

model FollowUp {
  id           String         @id @default(uuid())
  referralId   String
  scheduledAt  DateTime
  method       FollowUpMethod
  completed    Boolean        @default(false)
  outcomeNotes String?

  referral Referral @relation(fields: [referralId], references: [id])

  @@map("follow_ups")
}

model Outcome {
  id             String      @id @default(uuid())
  referralId     String      @unique
  outcomeType    OutcomeType
  resolvedAt     DateTime?
  feedbackRating Int?

  referral Referral @relation(fields: [referralId], references: [id])

  @@map("outcomes")
}
